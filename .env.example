# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/automation_studio?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate: openssl rand -hex 32  (never commit the real value)
ENCRYPTION_KEY="replace-with-32-byte-hex-key"

# Temporary single-customer open access (NetFree blocks Clerk). Not demo mode.
# Set both to 1 on Railway web+worker; set both to 0 to restore Clerk gates.
OPEN_ACCESS=1
NEXT_PUBLIC_OPEN_ACCESS=1
# Keep demo auth OFF while OPEN_ACCESS is on (no role switcher / demo UI).
ALLOW_DEMO_AUTH=0
NEXT_PUBLIC_ALLOW_DEMO_AUTH=0
CURSOR_MOCK=1
GITHUB_MOCK=1
RAILWAY_MOCK=1

# Cursor (server/worker only — never expose to browser)
CURSOR_API_KEY=
# Optional model override (defaults to account Auto via models.list → "default")
CURSOR_MODEL_ID=
# Platform default repo when a project has none connected (enables live plan mode)
DEFAULT_GITHUB_OWNER=
DEFAULT_GITHUB_REPO=
DEFAULT_GITHUB_INSTALLATION_ID=
DEFAULT_GITHUB_BRANCH=main

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Optional: register manifest app under a GitHub organization (omit for user accounts)
GITHUB_APP_ORG=
GITHUB_APP_NAME=Koda

# Email — required for real developer notify on program submit
RESEND_API_KEY=
# Verified sender in Resend (defaults to Resend onboarding address)
EMAIL_FROM="Koda <onboarding@resend.dev>"
# Where to email when a program is submitted (comma-separated).
# Without this, seed DEVELOPER/ADMIN @demo.local addresses are skipped.
NOTIFY_EMAIL=
# Optional alias for NOTIFY_EMAIL
DEVELOPER_NOTIFY_EMAIL=

# Staff / admin password gate while OPEN_ACCESS keeps public site as EMPLOYEE.
# Prefer ADMIN_PASSWORD; STAFF_ACCESS_TOKEN is an accepted alias.
# Open /staff, enter the password (form sets httpOnly cookie — never put it in the URL).
ADMIN_PASSWORD=
STAFF_ACCESS_TOKEN=
# Staff session lifetime in seconds (default 28800 = 8h)
STAFF_SESSION_MAX_AGE_SEC=28800

# --- Scaling / production (see docs/runbooks.md#scaling-for-production) ---
# Worker BullMQ concurrency per replica
WORKER_CONCURRENCY=5
# Global cap on simultaneous Cursor agent API sessions (all workers)
MAX_CONCURRENT_CURSOR_AGENTS=8
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_STALLED_COUNT=2
WORKER_HEALTH_PORT=8081
# Queue back-pressure (0 = unlimited waiting jobs)
QUEUE_MAX_WAITING=0
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_BACKOFF_DELAY_MS=3000
# SSE limits per web replica
SSE_MAX_CONNECTIONS_PER_PROGRAM=8
SSE_MAX_CONNECTIONS_TOTAL=500
SSE_MAX_CONNECTION_AGE_MS=7200000
SSE_POLL_INTERVAL_MS=1000
# API rate limits (per minute unless noted)
RATE_LIMIT_MESSAGES_PER_MIN=30
RATE_LIMIT_SUBMIT_PER_MIN=10
RATE_LIMIT_SECRETS_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=15
RATE_LIMIT_STAFF_UNLOCK=8
# Per-org secret encryption (requires re-save secrets after enabling)
ENCRYPTION_KEY_PER_ORG=0
# Postgres pool hint — append to DATABASE_URL on Railway, e.g. ?connection_limit=10
# DATABASE_URL=postgresql://...?connection_limit=10&pool_timeout=20

# Railway (server only — enables manifest callback to write GITHUB_APP_* vars)
RAILWAY_API_TOKEN=
# Worker service id on web service (manifest callback sets vars on both services)
RAILWAY_WORKER_SERVICE_ID=
