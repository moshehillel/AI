# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/automation_studio?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate: openssl rand -hex 32  (never commit the real value)
ENCRYPTION_KEY="replace-with-32-byte-hex-key"

# Open access: no login (single customer / EMPLOYEE on demo-co). Turn off when Clerk works.
OPEN_ACCESS=1
NEXT_PUBLIC_OPEN_ACCESS=1
# Same seed-auth path as OPEN_ACCESS; keep both on for Railway until Clerk is usable
ALLOW_DEMO_AUTH=1
NEXT_PUBLIC_ALLOW_DEMO_AUTH=1
CURSOR_MOCK=1
GITHUB_MOCK=1
RAILWAY_MOCK=1

# Cursor (server/worker only — never expose to browser)
CURSOR_API_KEY=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Optional: register manifest app under a GitHub organization (omit for user accounts)
GITHUB_APP_ORG=
GITHUB_APP_NAME=Koda

# Email (optional — without this, notifications queue to Admin inbox)
RESEND_API_KEY=
EMAIL_FROM="Koda <onboarding@resend.dev>"

# Railway (server only — enables manifest callback to write GITHUB_APP_* vars)
RAILWAY_API_TOKEN=
# Worker service id on web service (manifest callback sets vars on both services)
RAILWAY_WORKER_SERVICE_ID=
