# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/automation_studio?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
