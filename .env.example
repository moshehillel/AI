# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENCRYPTION_KEY="replace-with-32-byte-hex-or-base64-key"

# Cursor (server/worker only — never expose to browser)
CURSOR_API_KEY=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
